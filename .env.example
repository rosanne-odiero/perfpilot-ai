# Copy to .env and adjust. Every variable is optional.

# Where SQLite, artifacts and imported repository workspaces are stored.
PERFPILOT_DATA_DIR=data
# Override to use another database (SQLAlchemy URL).
# PERFPILOT_DATABASE_URL=sqlite:///data/perfpilot.sqlite3
PERFPILOT_LOG_LEVEL=INFO
# URL the Streamlit UI uses to reach the API.
PERFPILOT_API_BASE_URL=http://127.0.0.1:8000

# --- API hardening / observability ---------------------------------------------------------
# PERFPILOT_MAX_REQUEST_BYTES=1048576
# PERFPILOT_CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Emit OpenTelemetry spans (only if the opentelemetry packages are installed).
# PERFPILOT_OTEL_ENABLED=false

# --- docker compose (see docs/deployment.md) ------------------------------------------------
# Absolute host path of the data dir; mounted at the same path inside the containers.
# PERFPILOT_HOST_DATA_DIR=/absolute/path/to/data
# Host directory exposed read-only at /imports for local-directory imports.
# PERFPILOT_IMPORT_DIR=/absolute/path/to/repos
# PERFPILOT_API_PORT=8000
# PERFPILOT_UI_PORT=8501
# Group owning /var/run/docker.sock (0 on Docker Desktop; `stat -c %g /var/run/docker.sock` on Linux).
# PERFPILOT_DOCKER_GID=0

# --- Local repository import (disabled unless listed) --------------------------------
# Comma-separated directories the "Local directory" importer may read from.
# PERFPILOT_LOCAL_ALLOWLIST=~/Developer,~/code

# --- Ingestion limits -------------------------------------------------------------------
# PERFPILOT_MAX_UPLOAD_BYTES=104857600
# PERFPILOT_MAX_REPO_FILES=20000
# PERFPILOT_MAX_PYTHON_FILES=5000

# --- Optional LLM (any OpenAI-compatible endpoint) ----------------------------------------
# Without these, PerfPilot uses its deterministic advisor. Nothing is sent externally.
# OpenAI:        PERFPILOT_LLM_BASE_URL=https://api.openai.com/v1   PERFPILOT_LLM_MODEL=gpt-4o-mini
# Azure OpenAI:  PERFPILOT_LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1  PERFPILOT_LLM_MODEL=<deployment>
# Ollama:        PERFPILOT_LLM_BASE_URL=http://localhost:11434/v1   PERFPILOT_LLM_MODEL=qwen2.5-coder:7b
# PERFPILOT_LLM_BASE_URL=
# PERFPILOT_LLM_API_KEY=
# PERFPILOT_LLM_MODEL=
# PERFPILOT_LLM_MAX_TOKENS_PER_AUDIT=60000
# Optional cost accounting (USD per 1K tokens).
# PERFPILOT_LLM_INPUT_COST_PER_1K=0.00015
# PERFPILOT_LLM_OUTPUT_COST_PER_1K=0.0006

# --- Runtime audit sandbox (requires Docker) -------------------------------------------
# PERFPILOT_SANDBOX_BACKEND=docker
# PERFPILOT_SANDBOX_IMAGE=perfpilot-sandbox:latest
# PERFPILOT_SANDBOX_CPUS=2
# PERFPILOT_SANDBOX_MEMORY_MB=2048
# PERFPILOT_SANDBOX_TIMEOUT_SECONDS=600
# PERFPILOT_SANDBOX_PIDS_LIMIT=256
# PERFPILOT_SANDBOX_TMPFS_MB=256
# PERFPILOT_SANDBOX_OUTPUT_MAX_BYTES=16777216
# Absolute path of the docker CLI (default: PATH + /usr/local/bin, /opt/homebrew/bin, /usr/bin).
# PERFPILOT_SANDBOX_DOCKER_PATH=/usr/local/bin/docker
# Dependency install (separate, explicitly approved, network-enabled step).
# PERFPILOT_SANDBOX_INSTALL_TIMEOUT_SECONDS=900
# PERFPILOT_SANDBOX_PIP_INDEX_URL=https://pypi.org/simple
# PERFPILOT_SANDBOX_APPROVAL_TTL_SECONDS=86400
