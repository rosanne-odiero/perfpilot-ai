{
  "description": "Advisor evaluation scenarios. Each case is a tiny repository (files as lists of lines). 'expect.rules' must equal the set of rule ids detected; 'expect.kinds' must equal the set of recommendation kinds produced; 'expect.diff' says whether a suggested diff must (true) or must not (false) be attached; optional 'roles' (symbol -> code role) and 'insights' (titles that must appear). Cases with empty rules/kinds are negatives: no change should be recommended.",
  "cases": [
    {
      "id": "membership-list-param",
      "description": "Membership test against a list parameter inside a loop",
      "files": {"app/dedupe.py": [
        "def unique(items: list[str], seen: list[str]) -> list[str]:",
        "    for item in items:",
        "        if item not in seen:",
        "            seen.append(item)",
        "    return seen"
      ]},
      "expect": {"rules": ["PP-LOOP-001"], "kinds": ["set-membership"], "diff": false}
    },
    {
      "id": "membership-inline-literal",
      "description": "Membership test against an inline literal list of constants",
      "files": {"app/codes.py": [
        "def known(codes):",
        "    kept = []",
        "    for code in codes:",
        "        if code in [\"AA\", \"BB\", \"CC\", \"DD\", \"EE\", \"FF\", \"GG\"]:",
        "            kept.append(code)",
        "    return kept"
      ]},
      "expect": {"rules": ["PP-LOOP-001"], "kinds": ["set-membership"], "diff": true}
    },
    {
      "id": "membership-local-literal",
      "description": "Local literal list used only for membership tests",
      "files": {"app/block.py": [
        "def allowed(users):",
        "    blocked = [\"u1\", \"u2\", \"u3\", \"u4\", \"u5\", \"u6\", \"u7\"]",
        "    out = []",
        "    for user in users:",
        "        if user not in blocked:",
        "            out.append(user)",
        "    return out"
      ]},
      "expect": {"rules": ["PP-LOOP-001"], "kinds": ["set-membership"], "diff": true}
    },
    {
      "id": "string-concat-constant-init",
      "description": "String built with += from an empty string",
      "files": {"app/render.py": [
        "def render(rows: list[str]) -> str:",
        "    out = \"\"",
        "    for row in rows:",
        "        out += row + \"\\n\"",
        "    return out"
      ]},
      "expect": {"rules": ["PP-STR-001"], "kinds": ["string-join"], "diff": true}
    },
    {
      "id": "string-concat-unknown-init",
      "description": "String += where the initial value comes from a parameter: no mechanical diff",
      "files": {"app/render.py": [
        "def render(rows: list[str], header: str) -> str:",
        "    out = header",
        "    for row in rows:",
        "        out += row",
        "    return out"
      ]},
      "expect": {"rules": ["PP-STR-001"], "kinds": ["string-join"], "diff": false}
    },
    {
      "id": "regex-compile-in-loop",
      "description": "Constant re.compile inside a loop",
      "files": {"app/ids.py": [
        "import re",
        "",
        "",
        "def ids(lines):",
        "    found = []",
        "    for line in lines:",
        "        pattern = re.compile(r\"ID-(\\d+)\")",
        "        match = pattern.search(line)",
        "        if match:",
        "            found.append(match.group(1))",
        "    return found"
      ]},
      "expect": {"rules": ["PP-REGEX-001"], "kinds": ["precompile-regex"], "diff": true}
    },
    {
      "id": "nested-loop-join",
      "description": "Nested loops matching two collections by key",
      "files": {"app/join.py": [
        "def attach(orders, customers):",
        "    for order in orders:",
        "        for customer in customers:",
        "            if customer.id == order.customer_id:",
        "                order.customer = customer",
        "    return orders"
      ]},
      "expect": {"rules": ["PP-LOOP-002"], "kinds": ["index-join"], "diff": false}
    },
    {
      "id": "loop-invariant-sort",
      "description": "Sorting the same unchanged collection on every iteration",
      "files": {"app/rank.py": [
        "def ranks(items: list[int], queries: list[int]) -> list[int]:",
        "    out = []",
        "    for q in queries:",
        "        ordered = sorted(items)",
        "        out.append(ordered.index(q) if q in ordered else -1)",
        "    return out"
      ]},
      "expect": {"rules": ["PP-LOOP-003", "PP-LOOP-001", "PP-COLL-001"], "kinds": ["hoist-invariant", "set-membership", "index-lookup"], "diff": false}
    },
    {
      "id": "resort-growing-list",
      "description": "Re-sorting a list that grows inside the loop",
      "files": {"app/top.py": [
        "def top(scores):",
        "    best = []",
        "    for score in scores:",
        "        best.append(score)",
        "        best.sort()",
        "    return best[-3:]"
      ]},
      "expect": {"rules": ["PP-LOOP-004"], "kinds": ["incremental-ordering"], "diff": false}
    },
