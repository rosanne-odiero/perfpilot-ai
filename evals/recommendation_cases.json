        "    done = []",
        "    while queue:",
        "        done.append(queue.pop(0))",
        "    return done"
      ]},
      "expect": {"rules": ["PP-COLL-002"], "kinds": ["deque"], "diff": false}
    },
    {
      "id": "materialize-keys",
