    {
      "id": "n-plus-one-router",
      "description": "Two FastAPI handlers in one router with the same N+1 pattern -> one recommendation",
      "files": {"app/routes.py": [
        "from fastapi import APIRouter",
        "",
        "router = APIRouter()",
        "",
        "",
        "@router.get(\"/a\")",
        "def list_a(ids, db):",
        "    out = []",
        "    for i in ids:",
        "        out.append(db.query(i).first())",
        "    return out",
        "",
        "",
        "@router.get(\"/b\")",
        "def list_b(ids, db):",
        "    out = []",
        "    for i in ids:",
        "        out.append(db.query(i).first())",
        "    return out"
      ]},
      "expect": {"rules": ["PP-DB-001"], "kinds": ["batch-db-queries"], "diff": false, "recommendations": 1, "roles": {"list_a": "REQUEST_HANDLER", "list_b": "REQUEST_HANDLER"}}
    },
    {
