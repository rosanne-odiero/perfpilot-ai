ln\">42</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;prices = {}</td></tr>\n<tr><td class=\"ln\">43</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;for product in products:</td></tr>\n<tr><td class=\"ln\">44</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;ordered_rules = sorted(rules, key=lambda r: r.priority)</td></tr>\n  </table>\n</div>\n<div class=\"evidence\">\n  <p class=\"evidence-head\">#16 <span class=\"badge prov prov-static\">STATIC</span> copy.deepcopy inside a loop \u00b7 <span class=\"mono\">shopfast/orders.py:52</span></p>\n  <table class=\"code\">\n<tr><td class=\"ln\">52</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;for sku, quantity in updates:</td></tr>\n<tr><td class=\"ln\">53</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;state[sku] = state.get(sku, 0) + quantity</td></tr>\n<tr><td class=\"ln\">54</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;history.append(copy.deepcopy(state))</td></tr>\n  </table>\n</div>\n<div class=\"evidence\">\n  <p class=\"evidence-head\">#17 <span class=\"badge prov prov-static\">STATIC</span> Constant regex pattern processed inside a loop \u00b7 <span class=\"mono\">shopfast/reporting.py:44</span></p>\n  <table class=\"code\">\n<tr><td class=\"ln\">44</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;cleaned = []</td></tr>\n<tr><td class=\"ln\">45</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;for line in lines:</td></tr>\n<tr><td class=\"ln\">46</td><td class=\"src\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;email = re.compile(r&#34;[\\w.+-]+@[\\w-]+\\.[\\w.]+&#34;)</td></tr>\n  </table>\n</div>\n<div class=\"evidence\">\n  <p class=\"evidence-head\">#18 <span class=\"badge prov prov-static\">STATIC</span> Overlapping recursion without memoization \u00b7 <span class=\"mono\">shopfast/utils.py:8</span></p>\n  <table class=\"code\">\n<tr><td class=\"ln\">8</td><td class=\"src\">&nbsp;</td></tr>\n<tr><td class=\"ln\">9</td><td class=\"src\">&nbsp;</td><