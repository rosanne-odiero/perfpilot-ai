 "patch": {
  "generated_by": "deterministic",
  "transform": "list_count_to_counter",
  "target_file": "workload.py",
  "summary": "Count every element of `items` once with `Counter(items)` before the loop at line 12 and read counts from it (O(n) total instead of O(n) per call).",
  "notes": [
   "Elements of `items` (and the values counted) must be hashable; otherwise Counter raises TypeError where list.count() worked.",
   "Counter matches by hash + ==, list.count() by == only; they agree for well-behaved types.",
   "A missing key reads as 0, exactly like list.count() for an absent value.",
   "Extra memory: one dict entry per distinct element."
  ],
  "unified_diff": "--- a/workload.py\n+++ b/workload.py\n@@ -6,11 +6,14 @@\n \n from __future__ import annotations\n \n+from collections import Counter\n+\n \n def count_duplicates(items: list[str]) -> dict[str, int]:\n     duplicates: dict[str, int] = {}\n+    items_counts = Counter(items)\n     for item in items:\n-        occurrences = items.count(item)\n+        occurrences = items_counts[item]\n         if occurrences > 1:\n             duplicates[item] = occurrences\n     return duplicates\n",
  "diff_withheld_reason": null,
