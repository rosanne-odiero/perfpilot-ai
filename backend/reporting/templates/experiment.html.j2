<section>
{{ heading(11) }}
<ul>{% for item in r.limitations %}<li>{{ item }}</li>{% endfor %}</ul>
</section>

<footer class="report-footer">
  <p>Generated by {{ r.metadata.generator }} on {{ r.metadata.generated_at|dt }} · {{ r.metadata.subject_type }} <span class="mono">{{ r.metadata.subject_id }}</span> · experiment schema {{ r.schema_version }}{% if r.metadata.pdf_engine %} · PDF engine: {{ r.metadata.pdf_engine }}{% endif %} · {{ r.metadata.redactions_applied }} secret-like values redacted.</p>
</footer>
</div>
